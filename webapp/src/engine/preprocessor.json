{
  "schema": "visualears-preprocessor-v1",
  "description": "Browser-style log-mel feature pipeline for the VisualEars FastConformer-FA fixed-frame CTC cores. Matches the validated path in visualears-fastconformer-fa-webgpu/app.js and visualears_benchmark_269_browser_features.json (269/269 transcript parity).",
  "sample_rate": 16000,
  "n_fft": 512,
  "win_length": 400,
  "hop_length": 160,
  "n_mels": 80,
  "window": "hann",
  "window_formula": "0.5 - 0.5*cos(2*pi*i/(win_length-1))",
  "mel_scale": "htk",
  "hz_to_mel": "2595*log10(1+hz/700)",
  "mel_bin_formula": "floor((n_fft+1)*hz/sample_rate)",
  "fmin_hz": 0.0,
  "fmax_hz": 8000.0,
  "spectrum": "power",
  "fft_normalization": "1/n_fft",
  "log": "natural",
  "log_floor": 1e-20,
  "normalize": "per_mel_bin_mean_variance_over_valid_frames",
  "normalize_eps": 1e-5,
  "fixed_frames": 2005,
  "pad_value": 0.0,
  "frame_count_formula": "max(1, min(fixed_frames, floor((num_samples - win_length)/hop_length) + 1))",
  "input_name": "processed_signal",
  "input_layout": [1, 80, 2005],
  "logits_layout": [1, 251, 1025],
  "output_stride": 8,
  "ms_per_output_step": 80,
  "blank_id": 1024,
  "unk_id": 0,
  "ctc_decode": "greedy argmax; drop blank, repeats, and unk; join sentencepiece pieces; '▁' -> space"
}
